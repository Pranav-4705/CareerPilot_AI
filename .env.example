# ==========================================
# CareerPilot AI - Environment Configuration
# ==========================================

# Security & JWT
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Uploads
UPLOAD_DIR=uploads/resumes
MAX_UPLOAD_SIZE_MB=5

# Semantic Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Database (PostgreSQL)
POSTGRES_USER=careerpilot_user
POSTGRES_PASSWORD=careerpilot_password
POSTGRES_DB=careerpilot_db
POSTGRES_PORT=5432
POSTGRES_SERVER=localhost
DATABASE_URL=postgresql://careerpilot_user:careerpilot_password@localhost:5432/careerpilot_db

# Backend (FastAPI)
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEBUG=True

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
