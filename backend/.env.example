# ==============================================================================
# CareerPilot AI - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.

# Application Settings
PROJECT_NAME="CareerPilot AI"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Token Authentication
# In production, generate a strong random secret (e.g. openssl rand -hex 32)
SECRET_KEY="development_secret_key_change_in_production_1234567890_careerpilot"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to local SQLite (sqlite:///./careerpilot.db) if DATABASE_URL is unset.
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/careerpilot
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerpilot"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="careerpilot"

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# File Upload Configuration
UPLOAD_DIR="uploads/resumes"
MAX_UPLOAD_SIZE_MB=5

# Semantic Embedding Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Google Gemini API (Phase 8: Technical Interview)
# Obtain from https://aistudio.google.com/app/apikey
# Leave blank to use deterministic fallback (no Gemini calls)
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"

# OpenRouter API (Alternative Free Provider: supports "openrouter/free")
# Obtain free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL="openrouter/free"

# AI Provider Selection (backs app.services.ai_service.AIService)
#   ollama -> local Ollama first, Gemini/OpenRouter as an optional fallback
#   gemini -> Gemini/OpenRouter first
#   none   -> no provider (deterministic fallbacks only)
AI_PROVIDER="ollama"

# Local Ollama Provider (no API key required, requests stay on this machine)
# Start the server with `ollama serve` and pull the model once:
#   ollama pull llama3.2:3b
# Leave OLLAMA_MODEL empty to disable Ollama and use deterministic fallbacks.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Speech-to-Text (local Whisper, Phase C)
# STT_PROVIDER: faster-whisper (local) | none (disabled)
# Install the runtime once:  pip install faster-whisper
# The model downloads automatically on the first transcription (~150MB for base).
# To pre-download it explicitly:
#   huggingface-cli download Systran/faster-whisper-base
STT_PROVIDER="faster-whisper"
# Model size: tiny | base | small | medium | large-v3. `base` suits a 16GB laptop on CPU.
WHISPER_MODEL="base"
# "cpu" (default) or "cuda" when a GPU is available.
WHISPER_DEVICE="cpu"
# CTranslate2 compute type. `int8` is smallest/fastest on CPU.
WHISPER_COMPUTE_TYPE="int8"
# "auto" detects the spoken language, or force one e.g. "en".
WHISPER_LANGUAGE="auto"
WHISPER_BEAM_SIZE=5

# Audio upload limits for /speech/transcribe
MAX_AUDIO_UPLOAD_SIZE_MB=25
AUDIO_UPLOAD_DIR="uploads/audio"
# ==============================================================================
# Text-to-Speech (local Piper, Phase D)
# ==============================================================================
# Runtime installed with: pip install piper-tts
# piper-tts does NOT bundle voices, so download one .onnx + its .onnx.json
# sidecar ONCE into PIPER_VOICES_DIR (any voice from
# https://huggingface.co/rhasspy/piper-voices works; paths are
# <language>/<locale>/<name>/<size>/). Example, run from the backend/ folder:
#
#   .\venv\Scripts\python.exe -c "from huggingface_hub import hf_hub_download; import os, shutil; repo='rhasspy/piper-voices'; os.makedirs('models/piper', exist_ok=True); [shutil.copy(hf_hub_download(repo, f'en/en_US/amy/medium/en_US-amy-medium{s}'), os.path.join('models/piper', os.path.basename(f))) for s, f in (('.onnx','en/en_US/amy/medium/en_US-amy-medium.onnx'), ('.onnx.json','en/en_US/amy/medium/en_US-amy-medium.onnx.json'))]"
#
# TTS_PROVIDER: piper (local) | none (disabled)
TTS_PROVIDER="piper"
# Voice resolution: PIPER_MODEL_PATH wins, otherwise <PIPER_VOICE>.onnx is looked
# up inside PIPER_VOICES_DIR.
PIPER_VOICE="en_US-amy-medium"
PIPER_VOICES_DIR="models/piper"
# Set these only to use a voice outside PIPER_VOICES_DIR.
PIPER_MODEL_PATH=""
PIPER_CONFIG_PATH=""
# Independent of WHISPER_DEVICE; CPU needs no extra install.
PIPER_DEVICE="cpu"
# Prosody: length_scale > 1 speaks slower.
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W_SCALE=0.8
PIPER_SPEAKER_ID=
# Input limit for /speech/synthesize
MAX_TTS_TEXT_LENGTH=2000

# ==============================================================================
# LiveKit voice interview
# ==============================================================================
# From LiveKit Cloud: https://cloud.livekit.io (Project settings → Keys)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_AGENT_NAME="careerpilot-interviewer"
LIVEKIT_STT_MODEL="assemblyai/universal-3-5-pro"
LIVEKIT_LLM_MODEL="google/gemini-3.8-flash"
LIVEKIT_TTS_MODEL="fishaudio/s2.1-pro"
LIVEKIT_TTS_VOICE="fa4c9eb3dccc4806b382b40d61c6b10a"
